{
  "location": "eastus2",
  "properties": {
    "dataSources": {
      "performanceCounters": [
        {
          "name": "linuxPerf",
          "streams": ["Microsoft-Perf"],
          "samplingFrequencyInSeconds": 10,
          "counterSpecifiers": [
            "Processor(*)\\% Processor Time",
            "Memory(*)\\% Used Memory",
            "Memory(*)\\Available MBytes Memory",
            "Logical Disk(*)\\% Used Space",
            "Logical Disk(*)\\% Free Space",
            "Logical Disk(*)\\Free Megabytes"
          ]
        }
      ]
    },
    "destinations": {
      "logAnalytics": [
        {
          "workspaceResourceId": "/subscriptions/e964602f-6afc-4cc7-ba6b-3a796008e254/resourceGroups/rg-powergrid/providers/Microsoft.OperationalInsights/workspaces/law-powergrid",
          "name": "lawpowergrid"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": ["Microsoft-Perf"],
        "destinations": ["lawpowergrid"]
      }
    ]
  }
}
